# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large files / binary models
*.joblib
*.pkl
!best_model.joblib

# Datasets
*.csv
!incident_event_log.csv

# Research outputs are results, not datasets -- keep them tracked
!artifacts/**/*.csv
!reports/**/*.csv

# Streamlit config / secrets
.streamlit/secrets.toml

# Editor / agent tooling
.claude/

# Raw dataset distribution -- the adapters read csv_files/ instead
BPI Challenge 2013, incidents_1_all/

